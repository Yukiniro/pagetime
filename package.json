{
  "name": "pagetime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "wxt build",
    "build:preview": "vite build && node scripts/prepare-sites-build.mjs",
    "dev:extension": "wxt",
    "zip": "wxt zip",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "wxt prepare",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:prepare": "changeset version && npm install --package-lock-only --ignore-scripts",
    "verify-build": "node scripts/verify-build.mjs",
    "verify:zip": "node scripts/verify-build.mjs --zip",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "5.0.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "echarts": "6.1.0",
    "i18next": "^26.4.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.55.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.16",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fflate": "^0.8.3",
    "simple-icons": "^16.0.0",
    "typescript": "^5.9.3",
    "wxt": "0.21.4"
  }
}
